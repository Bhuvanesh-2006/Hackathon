# Copy to backend/.env and fill in. Never commit the real file.


# Set provider to deepseek so the backend uses the standard OpenAI client format
LLM_PROVIDER=deepseek

# Insert your actual Gemini API key here
DEEPSEEK_API_KEY=AQ.Ab8RN6L-3sI81Hn5IX_m_Fus_9BOcb3BsorkfqxnuX5rwf5kCw

# Specify your preferred Gemini model (e.g., gemini-1.5-pro, gemini-1.5-flash, or gemini-2.5-flash)
DEEPSEEK_MODEL=gemini-3.1-pro-preview

# Replace the original https://api.deepseek.com URL with Gemini's OpenAI-compatible endpoint
DEEPSEEK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Retrieval of verified SQL examples for the LLM: bge-faiss | keyword | none
# bge-faiss needs `pip install -r requirements-retrieval.txt`; otherwise keyword is used automatically.
RETRIEVAL_BACKEND=bge-faiss
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Data (defaults shown). SOURCE_EXCEL_PATH is only used by scripts/prepare_data.py.
# SOURCE_EXCEL_PATH=../online+retail+ii/online_retail_II.xlsx
# DATA_DIR=./data

# Dataset imports (CSV / XLSX)
MAX_UPLOAD_MB=50
MAX_IMPORT_COLUMNS=200

# Query-result cache (in-process; invalidated per dataset on re-import/delete)
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=256

# Query safety
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=1000
MAX_QUESTION_LENGTH=500

# Comma-separated origins allowed to call the API in development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
